# JARVIS Environment Variables Template
# 1. Copy this file to .env: cp env.example .env
# 2. Replace the placeholder values with your actual API keys

# Anthropic API key -- powers all reasoning (see config/model-policy.yaml
# for which Claude model handles which difficulty tier)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs API for Text-to-Speech
ELEVEN_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID for JARVIS voice
JARVIS_VOICE_ID=your_voice_id_here
# Faster/lower-latency default model works well for assistant responses.
ELEVEN_MODEL_ID=eleven_flash_v2_5
# auto (use Eleven when key exists), eleven (force cloud voice), macos (force local say)
JARVIS_TTS_MODE=auto

# OpenWeatherMap API key for the dashboard's weather widget (free tier: https://openweathermap.org/api)
# WEATHER_CITY format is "City,CountryCode" -- for US cities you must also
# include the country code or the API 404s: "City,StateCode,US" (e.g.
# "Madison,WI,US"), NOT just "City,StateCode".
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_CITY=Quezon City,PH

# Wake-word detector tuning (openWakeWord, local/offline)
# Comma-separated model names/files, e.g. hey_jarvis or hey_jarvis,alexa
WAKEWORD_MODELS=hey_jarvis
# Detection sensitivity in [0.0, 1.0] (higher = stricter)
WAKEWORD_THRESHOLD=0.5

# Seconds of silence required before JARVIS decides you've stopped talking
# and starts processing your command. Lower = faster responses but more risk
# of cutting you off during a natural mid-sentence pause. Was hardcoded to
# 3.0s (a flat 3-second tax on every single turn); default is now 1.0s.
JARVIS_SILENCE_STOP_SECONDS=1.0

# Local port the Electron app (frontend/main.js) listens on for wake-word
# focus events -- wake_system_integrated.py POSTs to it the instant the wake
# word fires so the JARVIS window jumps to the front immediately. Only
# needs changing if 3131 is already taken on your machine.
JARVIS_WAKE_PORT=3131

# --- Phase 2: Calendar + Gmail (Google OAuth2, Desktop app client) ---
# Create an OAuth 2.0 Client ID in Google Cloud Console with Calendar +
# Gmail scopes, then run an "installed app" OAuth flow once to get a
# refresh token. All MCP calendar_*/email_* tools return configured=False
# until these are real values.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# --- Phase 2: Canvas LMS ---
# Canvas -> Account -> Settings -> "New Access Token". Base URL is your
# school's Canvas instance, e.g. https://canvas.instructure.com or
# https://yourschool.instructure.com (no trailing slash).
CANVAS_BASE_URL=your_canvas_base_url_here
CANVAS_ACCESS_TOKEN=your_canvas_access_token_here

# Application Settings
MODE=dev
LOG_LEVEL=info
PORT=3000

# Default root for agent-created starter projects.
JARVIS_PROJECTS_ROOT=/Users/rahulremany/Desktop
