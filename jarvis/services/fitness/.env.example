# Copy this file to .env and fill in your values. .env is gitignored.

# Your Garmin Connect login (used by app/garmin_sync.py to pull recovery
# data). This is your real account password — python-garminconnect is an
# unofficial library that logs in as you, not an API-key integration.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Used for the coaching layer (workout recommendations, chat).
ANTHROPIC_API_KEY=

# Set to 0 to stop the app from auto-saving Claude's suggested workout to your
# Garmin workout library on launch (you can still save it by hand).
GARMIN_AUTO_SAVE_WORKOUT=1

# Cronometer login (used by app/cronometer_sync.py). Gold account required for
# export access. Manual sync only — no automatic trigger, ever.
CRONOMETER_EMAIL=
CRONOMETER_PASSWORD=

# How many manual Cronometer syncs are allowed per day before the button
# refuses (each sync spends 2 of Cronometer's rate-limited export calls).
CRONOMETER_DAILY_SYNC_LIMIT=5
